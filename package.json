{
  "name": "vibe-diagnosis",
  "version": "1.6.0",
  "description": "Self-diagnosis framework for vibe coding projects",
  "main": "src/runner.js",
  "bin": {
    "vibe-diag": "bin/vibe-diag.js"
  },
  "files": [
    "bin/",
    "src/",
    "mcp-server/index.js",
    "mcp-server/package.json",
    "templates/",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs && node scripts/scan-secrets.cjs && node bin/vibe-diag.js run --json",
    "test:unit": "node --test test/*.test.cjs",
    "test:example": "node bin/vibe-diag.js run --cwd examples/calculator --json",
    "test:rollback": "node examples/safe-repair-lab/verify-rollback.cjs",
    "test:packed": "node scripts/verify-packed-install.cjs",
    "test:secrets": "node scripts/scan-secrets.cjs"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "keywords": [
    "vibe-coding",
    "diagnosis",
    "testing",
    "self-diagnosis",
    "quality",
    "ai",
    "agent",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rejard/vibe-diagnosis.git"
  },
  "homepage": "https://github.com/Rejard/vibe-diagnosis#readme",
  "bugs": {
    "url": "https://github.com/Rejard/vibe-diagnosis/issues"
  },
  "author": "Rejard <lemaiiisk@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
